\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces How the three layers exchange information each simulated day. Solid arrows: the main model, in which information flows one way. Dashed arrows: the extension, which closes the loop from price back to demand. Interventions enter where they act: bypass and restraint in Layer\nobreakspace  {}1, reserves in Layer\nobreakspace  {}2.\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:flow}{{1}{7}{How the three layers exchange information each simulated day. Solid arrows: the main model, in which information flows one way. Dashed arrows: the extension, which closes the loop from price back to demand. Interventions enter where they act: bypass and restraint in Layer~1, reserves in Layer~2.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Layers 2 and 3 as networks. Left: each region's demand responds to one world price with its own elasticity $e$; each strategic reserve (Mb; maximum draw, mb/d) supplies only its own region. Right: the five-sector cascade inside one region; amber arrows give oil dependence, red arrows supplier needs.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:layers}{{4}{7}{Layers 2 and 3 as networks. Left: each region's demand responds to one world price with its own elasticity $e$; each strategic reserve (Mb; maximum draw, mb/d) supplies only its own region. Right: the five-sector cascade inside one region; amber arrows give oil dependence, red arrows supplier needs.\relax }{figure.caption.6}{}}
\newlabel{RF1}{8}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The route network under normal conditions (Hormuz open). Squares are regions' export (producer) nodes, circles consumer nodes shaded by unmet demand, diamonds chokepoints shaded by traffic relative to normal; line width and numbers are flow (mb/d).\relax }}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:map}{{2}{8}{The route network under normal conditions (Hormuz open). Squares are regions' export (producer) nodes, circles consumer nodes shaded by unmet demand, diamonds chokepoints shaded by traffic relative to normal; line width and numbers are flow (mb/d).\relax }{figure.caption.4}{}}
\newlabel{RF2}{9}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The same network at the observed Q2 2026 closure (Hormuz 77\% blocked): the Saudi pipeline fills and carries 7.0\,mb/d out through Bab el-Mandeb, North American oil crosses the Pacific through Panama, and China falls to 63\% of demand met.\relax }}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:mapq2}{{3}{9}{The same network at the observed Q2 2026 closure (Hormuz 77\% blocked): the Saudi pipeline fills and carries 7.0\,mb/d out through Bab el-Mandeb, North American oil crosses the Pacific through Panama, and China falls to 63\% of demand met.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Closure response. Left: chokepoint flows as Hormuz closes (dotted lines: EIA normal flows). Right: world unserved demand for Hormuz alone and with Bab el-Mandeb also closed; the shaded band is the 32--46\% threshold range of An et al. (2026), which uses a different failure definition.\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:closure}{{5}{10}{Closure response. Left: chokepoint flows as Hormuz closes (dotted lines: EIA normal flows). Right: world unserved demand for Hormuz alone and with Bab el-Mandeb also closed; the shaded band is the 32--46\% threshold range of An et al. (2026), which uses a different failure definition.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Rise in the critical blockade intensity above the 53.1\% baseline (percentage points). Blue: interventions of equal size ($\sim $3\,mb/d each). Orange: realistic sizes. The realistic reserve effect lasts only until regional stocks run out.\relax }}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:interv}{{6}{10}{Rise in the critical blockade intensity above the 53.1\% baseline (percentage points). Blue: interventions of equal size ($\sim $3\,mb/d each). Orange: realistic sizes. The realistic reserve effect lasts only until regional stocks run out.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Strategic reserves. Left: total reserves remaining at three closure levels. Centre: Brent price path; steps occur as regional reserves run out (Other Asia on day 167, China on day 350). Right: full closure with no reserves, realistic regional reserves, and a hypothetical pooled reserve with the same total draw rate.\relax }}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:reserves}{{7}{10}{Strategic reserves. Left: total reserves remaining at three closure levels. Centre: Brent price path; steps occur as regional reserves run out (Other Asia on day 167, China on day 350). Right: full closure with no reserves, realistic regional reserves, and a hypothetical pooled reserve with the same total draw rate.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Topology. Left: betweenness centrality of each chokepoint. Right: share of flow capacity lost when the most central chokepoint is removed, for the real network (red line, 5.6\%) and 200 random graphs of each type with the same numbers of nodes and edges (mean $\pm $ one standard deviation).\relax }}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:topo}{{8}{11}{Topology. Left: betweenness centrality of each chokepoint. Right: share of flow capacity lost when the most central chokepoint is removed, for the real network (red line, 5.6\%) and 200 random graphs of each type with the same numbers of nodes and edges (mean $\pm $ one standard deviation).\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Extension: worst-region systemic loss against Hormuz closure, main model and with price feedback (20\% cap). The dashed line marks the 10\% systemic criterion.\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ext}{{9}{11}{Extension: worst-region systemic loss against Hormuz closure, main model and with price feedback (20\% cap). The dashed line marks the 10\% systemic criterion.\relax }{figure.caption.11}{}}
